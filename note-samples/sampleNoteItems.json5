	"memos": [
		{
			"id": "memo-0420",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 20
				},
				"targetKey": "2026-04-20"
			},
			"title": "帳場メモ",
			"body": "東棟203に先の予約が入っていた。連休前は開けるなと言われていた部屋なのに、帳場では「女将確認済み」。みんな口が重い。",
			"source": "operator"
		},
		{
			"id": "memo-0421",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 21
				},
				"targetKey": "2026-04-21"
			},
			"title": "板場メモ",
			"body": "佐伯さんの席だけ器も進みも違う。若旦那も女将も知らないと言うのに、板長だけ最初から段取りを決めていた。",
			"source": "operator"
		},
		{
			"id": "memo-0422",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 22
				},
				"targetKey": "2026-04-22"
			},
			"title": "夜の見回りメモ",
			"body": "離れ・椿のお客様は、鍵は閉めていないと言う。椿の間だけ、建具の癖では説明しづらい閉まり方をする。",
			"source": "operator"
		},
		{
			"id": "memo-0423",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 23
				},
				"targetKey": "2026-04-23"
			},
			"title": "客歴メモ",
			"body": "沢渡妙子さんの名前を見て、番頭だけ動きが止まった。予約も支払いもきれいだが、古い宿帳を一人で出していた。",
			"source": "operator"
		},
		{
			"id": "memo-0424",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 24
				},
				"targetKey": "2026-04-24"
			},
			"title": "送迎メモ",
			"body": "17:20便の名簿には倉持美月さんの名前があるのに、現地には姿がない。館内では「もう来ている」と言う人もいて、別名の昼便予約も気になる。",
			"source": "operator"
		},
		{
			"id": "memo-0425",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 25
				},
				"targetKey": "2026-04-25"
			},
			"title": "台帳メモ",
			"body": "東棟203の予約は電話記録にもOTAにも出ていない。手書き台帳にだけあり、字は女将のものに見える。",
			"source": "operator"
		},
		{
			"id": "memo-0430",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 4,
					"day": 30
				},
				"targetKey": "2026-04-30"
			},
			"title": "照合メモ",
			"body": "藤沢美咲は昼便で先入り、倉持美月は最終便で未着。同じ日に同じ宿を使っている。偶然ではなさそう。",
			"source": "operator"
		},
		{
			"id": "memo-0505",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 5
				},
				"targetKey": "2026-05-05"
			},
			"title": "厨房メモ",
			"body": "山百合の間だけ、人数にない子ども膳を毎年出している。板場も帳場も「前からそうだから」で終わる。",
			"source": "operator"
		},
		{
			"id": "memo-0508",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 8
				},
				"targetKey": "2026-05-08"
			},
			"title": "脱衣場メモ",
			"body": "男湯の指輪は岡部拓海さんのものに見える。本人は露天付客室で別の女性と宿泊中。同じ日に篠原奈央さんも館内にいる。",
			"source": "operator"
		},
		{
			"id": "memo-0510",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 10
				},
				"targetKey": "2026-05-10"
			},
			"title": "稼働メモ",
			"body": "満室が近いのに東棟203だけ空けたまま。女将は「まだ触らないで」としか言わない。",
			"source": "operator"
		},
		{
			"id": "memo-0512",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 12
				},
				"targetKey": "2026-05-12"
			},
			"title": "若女将まわりメモ",
			"body": "真山恒一さんが若女将を旧姓で呼んだ。本人は笑って流したが、番頭がすぐ話を切った。",
			"source": "operator"
		},
		{
			"id": "memo-0515",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 15
				},
				"targetKey": "2026-05-15"
			},
			"title": "離れ調査メモ",
			"body": "離れ・椿の床下に新しい擦れ跡あり。夜だけ閉まる鍵の件と無関係とは思えない。",
			"source": "operator"
		},
		{
			"id": "memo-0519",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 19
				},
				"targetKey": "2026-05-19"
			},
			"title": "到着メモ",
			"body": "早川真司さんが203を指名して到着。荷物は少なく、遺影だけを大事そうに持っていた。",
			"source": "operator"
		},
		{
			"id": "memo-0521",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 21
				},
				"targetKey": "2026-05-21"
			},
			"title": "板場裏メモ",
			"body": "佐伯紀子さんは、板長の昔の名字を知っているようだった。料理の進みを見ている顔が、初めての客には見えない。",
			"source": "operator"
		},
		{
			"id": "memo-0523",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 23
				},
				"targetKey": "2026-05-23"
			},
			"title": "古参メモ",
			"body": "離れ・椿には先代の金庫があった、という話を古参だけが知っている。鍵の件も、みんな笑って流さない。",
			"source": "operator"
		},
		{
			"id": "memo-0524",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 24
				},
				"targetKey": "2026-05-24"
			},
			"title": "送迎裏メモ",
			"body": "小田切沙耶さんの名前を書いた迎え札を、宿と関係のない男が持っていた。子どもの荷物を見て宿を特定したらしい。",
			"source": "operator"
		},
		{
			"id": "memo-0526",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 26
				},
				"targetKey": "2026-05-26"
			},
			"title": "番頭メモ",
			"body": "沢渡妙子さんの本名は秋月千春さん。三十年前、見合いから逃げる番頭見習いに夜行バス代を渡した相手だそう。",
			"source": "operator"
		},
		{
			"id": "memo-0527",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 27
				},
				"targetKey": "2026-05-27"
			},
			"title": "宿帳メモ",
			"body": "早川恒一さんは二十年前の豪雨の日に203へ泊まっていた。送迎の順が変えられ、怪我の記録だけが抜けている。",
			"source": "operator"
		},
		{
			"id": "memo-0530",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 5,
					"day": 30
				},
				"targetKey": "2026-05-30"
			},
			"title": "料理場メモ",
			"body": "佐伯さんへの特別膳は嫌がらせではなく、「自分が捨てた味」を最後に見せるための一皿だった、と板長はそれだけ言った。",
			"source": "operator"
		},
		{
			"id": "memo-0601",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 6,
					"day": 1
				},
				"targetKey": "2026-06-01"
			},
			"title": "回収メモ",
			"body": "離れ・椿の床下から出たのは金庫ではなく手紙束。宛名は「芙美子へ」。金庫の話は目くらましだったのかもしれない。",
			"source": "operator"
		},
		{
			"id": "memo-0602",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 6,
					"day": 2
				},
				"targetKey": "2026-06-02"
			},
			"title": "送迎回収メモ",
			"body": "倉持さんの未着の件は再会ではなく尾行だった。倉持美月さんは鳴海悠人さんを追って、別名で先入りしていた。",
			"source": "operator"
		},
		{
			"id": "memo-0603",
			"target": {
				"kind": "day",
				"targetDateYmdhms": {
					"year": 2026,
					"month": 6,
					"day": 3
				},
				"targetKey": "2026-06-03"
			},
			"title": "締めメモ",
			"body": "早川真司さんは203に一晩だけ泊まり、何も言わず帰った。沢渡妙子さんも同じ日に静かに発った。残ったのは宿側の記憶だけ。",
			"source": "operator"
		}
	]
}