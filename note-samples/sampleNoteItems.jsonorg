  "memos": [
    {
      "id": "memo-0420",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 20
        },
        "targetKey": "2026-04-20"
      },
      "title": "帳場メモ",
      "body": "東棟203に未来日の予約が入っている。連休前に使うなと何度も言われていた部屋だが、帳場では『女将確認済』の扱い。誰も強く触れたがらない。",
      "source": "operator"
    },
    {
      "id": "memo-0421",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 21
        },
        "targetKey": "2026-04-21"
      },
      "title": "板場メモ",
      "body": "佐伯の席だけ、器も進行も違う。若旦那も女将も知らないと言うのに、板長だけが最初から段取りを決めていた。",
      "source": "operator"
    },
    {
      "id": "memo-0422",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 22
        },
        "targetKey": "2026-04-22"
      },
      "title": "夜間見回りメモ",
      "body": "離れ・椿の客は鍵を閉めていないと言う。建具の歪みだけで説明するには、閉まり方が人の手に近い。",
      "source": "operator"
    },
    {
      "id": "memo-0423",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 23
        },
        "targetKey": "2026-04-23"
      },
      "title": "客歴メモ",
      "body": "沢渡妙子の名を見て番頭だけが止まった。予約も支払いも完璧だが、昔の宿帳を一人で出していた。",
      "source": "operator"
    },
    {
      "id": "memo-0424",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 24
        },
        "targetKey": "2026-04-24"
      },
      "title": "送迎メモ",
      "body": "17:20便の名簿には倉持美月。だが現地には姿がなく、館内では『もう来ている』と言う声もある。別名の昼便予約を洗う必要あり。",
      "source": "operator"
    },
    {
      "id": "memo-0425",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 25
        },
        "targetKey": "2026-04-25"
      },
      "title": "台帳照合メモ",
      "body": "203号の予約は電話記録にもOTAにも出ない。帳場の手書き台帳だけにあり、筆跡は女将のもの。",
      "source": "operator"
    },
    {
      "id": "memo-0430",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 4,
          "day": 30
        },
        "targetKey": "2026-04-30"
      },
      "title": "照合メモ",
      "body": "藤沢美咲は昼便で先入り、倉持美月は最終便で未着。どちらも同日に同じ宿を使っている。偶然ではない。",
      "source": "operator"
    },
    {
      "id": "memo-0505",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 5
        },
        "targetKey": "2026-05-05"
      },
      "title": "厨房メモ",
      "body": "山百合の間だけ、予約人数にない子ども膳を毎年出している。板場も帳場も『前からそうだから』で通している。",
      "source": "operator"
    },
    {
      "id": "memo-0508",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 8
        },
        "targetKey": "2026-05-08"
      },
      "title": "脱衣場メモ",
      "body": "男湯の指輪は岡部拓海のものに見える。本人は露天付客室で別の女性と宿泊中、同じ日に篠原奈央も館内にいる。",
      "source": "operator"
    },
    {
      "id": "memo-0510",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 10
        },
        "targetKey": "2026-05-10"
      },
      "title": "稼働メモ",
      "body": "満室が近いのに203だけ空け続けるのは不自然。女将は『まだ触らないで』とだけ言う。",
      "source": "operator"
    },
    {
      "id": "memo-0512",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 12
        },
        "targetKey": "2026-05-12"
      },
      "title": "若女将メモ",
      "body": "真山恒一は若女将を旧姓で呼んだ。本人は笑って流したが、番頭が露骨に話題を切った。",
      "source": "operator"
    },
    {
      "id": "memo-0515",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 15
        },
        "targetKey": "2026-05-15"
      },
      "title": "離れ調査メモ",
      "body": "離れ・椿の床下に新しい擦れ跡。夜だけ閉まる鍵の件と無関係とは思えない。",
      "source": "operator"
    },
    {
      "id": "memo-0519",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 19
        },
        "targetKey": "2026-05-19"
      },
      "title": "到着メモ",
      "body": "早川真司が203を指名して到着。荷物は少なく、遺影だけを大事そうに持っていた。",
      "source": "operator"
    },
    {
      "id": "memo-0521",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 21
        },
        "targetKey": "2026-05-21"
      },
      "title": "板場裏メモ",
      "body": "佐伯紀子は、板長の昔の名字を知っているようだった。料理の進みを見ている顔が、初見の客ではない。",
      "source": "operator"
    },
    {
      "id": "memo-0523",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 23
        },
        "targetKey": "2026-05-23"
      },
      "title": "古参メモ",
      "body": "離れには先代が使った金庫があった、という話が古参の間でだけ通じる。鍵の件は笑って流されない。",
      "source": "operator"
    },
    {
      "id": "memo-0524",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 24
        },
        "targetKey": "2026-05-24"
      },
      "title": "送迎裏メモ",
      "body": "小田切沙耶の名前を書いた迎え札を、宿と関係のない男が持っていた。子どもの荷物を見て宿を特定したらしい。",
      "source": "operator"
    },
    {
      "id": "memo-0526",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 26
        },
        "targetKey": "2026-05-26"
      },
      "title": "番頭メモ",
      "body": "沢渡妙子の本名は秋月千春。三十年前、見合いから逃げる番頭見習いに夜行バス代を渡した相手だという。",
      "source": "operator"
    },
    {
      "id": "memo-0527",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 27
        },
        "targetKey": "2026-05-27"
      },
      "title": "宿帳メモ",
      "body": "早川恒一は二十年前の豪雨の日に203へ泊まっていた。送迎の順を変えられ、怪我をした記録だけが抜けている。",
      "source": "operator"
    },
    {
      "id": "memo-0530",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 5,
          "day": 30
        },
        "targetKey": "2026-05-30"
      },
      "title": "料理場メモ",
      "body": "特別膳は嫌がらせではなく、『自分が捨てた味』を最後に見せるための一皿だった。板長はそうとだけ言った。",
      "source": "operator"
    },
    {
      "id": "memo-0601",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 6,
          "day": 1
        },
        "targetKey": "2026-06-01"
      },
      "title": "回収メモ",
      "body": "離れ・椿の床下から出たのは金庫ではなく手紙束。宛名は『芙美子へ』。先代の愛人宛てと思われる。",
      "source": "operator"
    },
    {
      "id": "memo-0602",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 6,
          "day": 2
        },
        "targetKey": "2026-06-02"
      },
      "title": "送迎回収メモ",
      "body": "未着客の件は再会ではなく尾行だった。倉持美月は鳴海悠人を追って別名で先入りしていた。",
      "source": "operator"
    },
    {
      "id": "memo-0603",
      "target": {
        "kind": "day",
        "targetDateYmdhms": {
          "year": 2026,
          "month": 6,
          "day": 3
        },
        "targetKey": "2026-06-03"
      },
      "title": "締めメモ",
      "body": "早川真司は203に一晩だけ泊まり、何も求めず帰った。沢渡妙子も同じ日に静かに発った。残ったのは宿側だけの記憶。",
      "source": "operator"
    }
  ]
}